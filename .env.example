# Copy to .env and fill in. Never commit .env.

# --- LLM (required for research / scrape / analyze) -------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Optional cheaper model for the light agents (Source Selector, Reporter), e.g.
# anthropic/claude-haiku-5.5 at about 1/20 of Sonnet's price. Empty = use LLM_MODEL.
LLM_FAST_MODEL=

# --- HTTP transport ----------------------------------------------------------------
# Required before exposing the server beyond localhost (clients send "Authorization: Bearer <token>").
MCP_AUTH_TOKEN=
# Extra Host names to accept, e.g. your tunnel domain: abc123.trycloudflare.com
MCP_ALLOWED_HOSTS=
# Endpoint path. For a public tunnel without header auth, make it long and random.
MCP_PATH=/mcp

# --- Scraping politeness -----------------------------------------------------------
# Who you are: your repo URL or e-mail, appended to the User-Agent. Some sites (Wikipedia, for one)
# refuse automated requests without a way to contact the operator.
SCRAPER_CONTACT=
RESPECT_ROBOTS=true
REQUEST_DELAY=1.0
MAX_CONCURRENCY=4
USER_AGENT=scraper-mcp/0.1 (educational web-scraping project)
